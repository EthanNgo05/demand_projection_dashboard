# Data & generated output (live at the repo root, alongside src/)
/raw_inputs
/outputs
/logs

# sql/ IS tracked. These batches pin the extract's history range and carry its
# read-only contract (every write targets a #temp table -- enforced by
# tests/test_sql_read_only.py), so a change to them must produce a reviewable
# diff. Only the editor scratch dir and the archived pre-rewrite copies are
# ignored; sql/original/ is referenced nowhere in code and must never be run.
/sql/.vs/
/sql/original/

# Docs & exploratory notebooks
/docs
/notebooks

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Parquet fast-load sidecars are a regenerable read cache written next to each
# .xlsx snapshot (raw_inputs is already ignored; this covers the test fixtures,
# which read_raw_frame backfills on first read).
tests/fixtures/*.parquet

# Secrets
.env
.streamlit/secrets.toml

# Local tooling
.claude/
